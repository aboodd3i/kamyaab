# =============================================================================
# Kamyaab Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is gitignored.
# =============================================================================

# ---- Database (Supabase PostgreSQL) -----------------------------------------
# DATABASE_URL: Connection string for the Prisma client runtime queries.
#   Used by src/lib/prisma.ts and prisma/seed.ts.
#   Format: postgresql://user:password@host:port/database
DATABASE_URL=

# DIRECT_URL: Connection string used by Prisma migrate/CLI for DDL operations.
#   Used by prisma.config.ts via env("DIRECT_URL").
#   On Supabase this is the *direct* (non-pooled) connection string,
#   because connection pooling (PgBouncer) does not support all migration
#   commands. DATABASE_URL may use the pooled connection; DIRECT_URL must not.
DIRECT_URL=

# ---- Supabase Auth & Storage ------------------------------------------------
# SUPABASE_URL: Your Supabase project URL (https://<project>.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Public anon key — safe for client-side requests.
#   Used by the backend to verify client OTP tokens and read auth state.
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Server-only service role key.
#   Grants full access — NEVER expose to frontend code or client responses.
#   Used only in backend admin/seed operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase Storage (CNIC documents) -------------------------------------
# SUPABASE_CNIC_BUCKET: Private bucket name for CNIC document uploads.
#   Must be a private bucket — never make it public.
#   The application will fail at startup if this is missing when document
#   upload is attempted.
SUPABASE_CNIC_BUCKET=

# ---- Supabase Storage (Complaint evidence files) ---------------------------
# SUPABASE_COMPLAINT_BUCKET: Private bucket name for complaint evidence uploads.
#   Must be a private bucket — never make it public.
#   Separate from CNIC bucket for access control isolation.
SUPABASE_COMPLAINT_BUCKET=

# ---- Server -----------------------------------------------------------------
# PORT: Express listen port (default: 3000)
PORT=3000

# NODE_ENV: development | test | staging | production
NODE_ENV=development
