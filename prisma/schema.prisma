// Kamyaab — Prisma schema
// Core models for the MVP marketplace: User, ClientProfile, WorkerProfile,
// Category, Area, and Week 4: JobRequest, JobInvitation, Booking.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ------------------------------------------------------------------

enum UserRole {
  CLIENT
  AGENT
  ADMIN
}

enum WorkerStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
}

enum ReferenceCheckStatus {
  UNVERIFIED
  CONTACTED
  CONFIRMED
  FAILED
}

// Week 4: Job request type — specific worker (Flow A) or open job (Flow B, Week 5)
enum JobRequestType {
  SPECIFIC_WORKER
  OPEN
}

// Week 4: Job request lifecycle
// DRAFT            — saved but not yet submitted
// WORKER_CONTACTED — submitted; invitation sent to target worker
// ACCEPTED         — worker accepted; booking created
// EXPIRED          — 24-hour window elapsed with no response
// CANCELLED        — client cancelled before acceptance
enum JobRequestStatus {
  DRAFT
  WORKER_CONTACTED
  MATCHING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// Week 4: How urgently the client needs the work done
enum UrgencyLevel {
  FLEXIBLE // No strict deadline
  THIS_WEEK // Within the next 7 days
  URGENT // Within 24 hours
}

// Week 4: Invitation lifecycle
// PENDING  — sent to worker, awaiting response
// ACCEPTED — worker accepted (triggers Booking creation)
// REJECTED — worker declined
// EXPIRED  — 24-hour window elapsed without response
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

// Week 4: Booking lifecycle
// CONFIRMED — contact released to both parties
// COMPLETED — job marked done (enables reviews in Week 6)
// CANCELLED — cancelled after booking but before completion
enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Week 5: Worker availability tracking
enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
  UNKNOWN
}

enum AvailabilityUpdateSource {
  WORKER_PORTAL
  SMS
  AGENT
  ADMIN
  AUTO_EXPIRY
}

model WorkerAvailability {
  id       String        @id @default(uuid())
  workerId String        @unique
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  status       AvailabilityStatus       @default(UNKNOWN)
  updateSource AvailabilityUpdateSource @default(AUTO_EXPIRY)
  busyUntil    DateTime?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Week 6: Review direction — who is reviewing whom
enum ReviewDirection {
  CLIENT_TO_WORKER
  WORKER_TO_CLIENT
}

// --- Models -----------------------------------------------------------------

model User {
  id         String   @id @default(uuid())
  authUserId String?  @unique /// Immutable Supabase Auth user ID — the stable identity mapping
  phone      String?  @unique
  email      String?  @unique
  role       UserRole
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clientProfile  ClientProfile?
  workerProfile  WorkerProfile?  @relation("UserWorkerProfile")
  createdWorkers WorkerProfile[] @relation("AgentWorkerProfiles")

  // Week 3: Reference verification relationships
  verifiedWorkerReferences WorkerProfile[] @relation("ReferenceVerifier")

  // Week 6: Reviews authored by and targeting this user
  reviewsGiven    Review[] @relation("ReviewReviewer")
  reviewsReceived Review[] @relation("ReviewReviewee")
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Week 4: Jobs posted by this client
  jobRequests JobRequest[]
}

model WorkerProfile {
  id               String       @id @default(uuid())
  userId           String?      @unique
  user             User?        @relation("UserWorkerProfile", fields: [userId], references: [id])
  name             String
  phone            String       @unique
  status           WorkerStatus @default(PENDING_APPROVAL)
  suspensionReason String?
  agentId          String?
  agent            User?        @relation("AgentWorkerProfiles", fields: [agentId], references: [id])

  // Week 3: CNIC and verification fields
  cnicNumber    String? @unique
  cnicFrontPath String?
  cnicBackPath  String?

  // Week 3: Reference check
  referenceName         String?
  referencePhone        String?
  referenceStatus       ReferenceCheckStatus @default(UNVERIFIED)
  referenceVerifiedById String?
  referenceVerifiedBy   User?                @relation("ReferenceVerifier", fields: [referenceVerifiedById], references: [id], onDelete: SetNull)
  referenceVerifiedAt   DateTime?

  // Week 3: Verification flags
  identityChecked   Boolean @default(false)
  phoneConfirmed    Boolean @default(false)
  backgroundChecked Boolean @default(false)
  skillAssessed     Boolean @default(false)

  // Week 3: Rating and performance
  rating             Decimal @default(0) @db.Decimal(3, 2)
  ratingCount        Int     @default(0)
  completedJobsCount Int     @default(0)
  isPriorityListed   Boolean @default(false)

  // Week 3: Search relationships
  categories   WorkerCategory[]
  serviceAreas WorkerServiceArea[]

  // Week 4: Jobs targeting this worker and bookings
  targetedJobRequests JobRequest[]        @relation("TargetWorker")
  invitations         JobInvitation[]
  bookings            Booking[]
  availability        WorkerAvailability?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, rating(desc), completedJobsCount(desc)])
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  // Week 3: Worker relationships
  workers WorkerCategory[]

  // Week 4: Job requests in this category
  jobRequests JobRequest[]
}

model Area {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?
  parent   Area?   @relation("AreaHierarchy", fields: [parentId], references: [id])
  children Area[]  @relation("AreaHierarchy")

  // Week 3: Worker relationships
  workers     WorkerServiceArea[]
  // Week 4: Job requests in this area
  jobRequests JobRequest[]
}

model WorkerCategory {
  workerId   String
  categoryId String

  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
  @@index([categoryId])
  @@map("worker_categories")
}

model WorkerServiceArea {
  workerId String
  areaId   String

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  area   Area          @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([workerId, areaId])
  @@index([areaId])
  @@map("worker_service_areas")
}

// --- Week 4 Models ----------------------------------------------------------

/// A job request created by a client.
/// Flow A (SPECIFIC_WORKER): targets one worker → one invitation → booking.
/// Flow B (OPEN, Week 5): matched to multiple workers via deterministic ranking.
model JobRequest {
  id String @id @default(uuid())

  // Who posted the job
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id])

  // What kind of work
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Where the work is needed
  areaId String
  area   Area   @relation(fields: [areaId], references: [id])

  // Job details
  description String /// Free-text description of the work needed
  urgency     UrgencyLevel @default(FLEXIBLE)
  budget      Decimal?     @db.Decimal(10, 2) /// Optional indicative budget in PKR

  // Request type and lifecycle
  type   JobRequestType   @default(SPECIFIC_WORKER)
  status JobRequestStatus @default(DRAFT)

  // Flow A: the specific worker the client chose (null for OPEN jobs)
  targetWorkerId String?
  targetWorker   WorkerProfile? @relation("TargetWorker", fields: [targetWorkerId], references: [id])

  // Timestamps
  submittedAt DateTime? /// Set when status moves from DRAFT → WORKER_CONTACTED
  expiresAt   DateTime? /// Deadline for worker response; used by expiry background job
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  invitations JobInvitation[]
  booking     Booking?

  @@index([clientId, status]) /// Client's "My Jobs" list query
  @@index([status, expiresAt]) /// Expiry background job query
}

/// One invitation sent to a worker for a specific JobRequest.
/// Flow A: always exactly one invitation per SPECIFIC_WORKER request.
/// Flow B (Week 5): one per matched worker (batch-created).
model JobInvitation {
  id String @id @default(uuid())

  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id])

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  status InvitationStatus @default(PENDING)

  // SMS tracking — mocked in MVP
  smsSentAt   DateTime? /// When the mock SMS was dispatched to the worker
  respondedAt DateTime? /// When the worker accepted or rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking? /// Created when this invitation is accepted

  @@unique([jobRequestId, workerId]) /// One invitation per worker per job
  @@index([workerId, status]) /// Worker's pending-invitations inbox
  @@index([status, createdAt]) /// Expiry job: find stale PENDING invitations
}

/// A confirmed booking created when a worker accepts a JobInvitation.
/// Contact details (phone numbers) are released to both parties on creation.
model Booking {
  id String @id @default(uuid())

  jobRequestId String     @unique /// One booking per job request
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id])

  invitationId String        @unique /// The accepted invitation that created this booking
  invitation   JobInvitation @relation(fields: [invitationId], references: [id])

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  status BookingStatus @default(CONFIRMED)

  // Contact release — stored so both parties retain a reference
  clientPhone String? /// Client phone released to worker on booking confirmation
  workerPhone String? /// Worker phone released to client on booking confirmation

  confirmedAt DateTime  @default(now()) /// When the booking was created / contact released
  completedAt DateTime? /// Set when status moves to COMPLETED
  cancelledAt DateTime? /// Set when status moves to CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Week 6: Reviews for this booking (max one per direction)
  reviews Review[]

  @@index([workerId, status])
}

/// Week 6: A review left by one party on a completed booking.
/// Exactly one CLIENT_TO_WORKER and one WORKER_TO_CLIENT review per booking.
model Review {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  reviewerUserId String
  reviewer       User   @relation("ReviewReviewer", fields: [reviewerUserId], references: [id])

  revieweeUserId String
  reviewee       User   @relation("ReviewReviewee", fields: [revieweeUserId], references: [id])

  direction ReviewDirection
  rating    Int /// 1–5 star rating
  comment   String? /// Optional free-text comment (max 1000 chars)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, direction]) /// One review per direction per booking
  @@index([reviewerUserId])
  @@index([revieweeUserId])
}
