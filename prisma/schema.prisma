// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  role      String   // "CLIENT" | "AGENT" | "ADMIN"
  createdAt DateTime @default(now())

  clientProfile ClientProfile?
  workerProfile WorkerProfile? @relation("UserWorkerProfile")
  createdWorkers WorkerProfile[] @relation("AgentWorkerProfiles")
}

model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  name   String?
}

model WorkerProfile {
  id        String   @id @default(uuid())
  userId    String?  @unique
  user      User?    @relation("UserWorkerProfile", fields: [userId], references: [id])
  name      String
  phone     String
  status    String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, SUSPENDED
  agentId   String?
  agent     User?    @relation("AgentWorkerProfiles", fields: [agentId], references: [id])
  createdAt DateTime @default(now())
}

model Category {
  id   String @id @default(uuid())
  name String @unique
}

model Area {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  parent   Area?   @relation("AreaHierarchy", fields: [parentId], references: [id])
  children Area[]  @relation("AreaHierarchy")
}
